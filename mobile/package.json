{
  "name": "bite-routine-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.0.25",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.20",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-sharing": "~58.0.23",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --android --go",
    "ios": "expo start --ios --go",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "lint": "expo lint",
    "check:deps": "expo install --check",
    "export:ios": "expo export --platform ios",
    "start:dev": "expo start --dev-client",
    "build:ios:device": "EX_DEV_CLIENT_NETWORK_INSPECTOR=false expo run:ios --device",
    "export:android": "expo export --platform android --output-dir dist-android",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "check:catalog": "node scripts/sync-catalog.mjs --check"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ]
  },
  "type": "module"
}
